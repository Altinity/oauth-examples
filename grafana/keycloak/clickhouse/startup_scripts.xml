<clickhouse>
    <!--
      Every statement here must be idempotent, because startup scripts run on
      every server start and a single failing statement aborts the rest of the
      sequence. A plain CREATE TABLE would throw TABLE_ALREADY_EXISTS on the
      second start, skipping the GRANTs below while CREATE ROLE OR REPLACE had
      already dropped the roles' privileges, leaving users authenticated but
      unable to read anything.
    -->
    <startup_scripts>
        <!-- this role will only be assigned to one user -->
        <scripts>
            <query>CREATE ROLE OR REPLACE 'can_read'</query>
        </scripts>
        <!-- this role will be assigned to all users defined using access token external user directory -->
        <scripts>
            <query>CREATE ROLE OR REPLACE 'general_role'</query>
        </scripts>

        <scripts>
            <query>CREATE TABLE IF NOT EXISTS default.can_read_specific ENGINE=TinyLog AS SELECT 'can_read_specific' AS str</query>
        </scripts>
        <scripts>
            <query>CREATE TABLE IF NOT EXISTS default.can_read_general ENGINE=TinyLog AS SELECT 'can_read_general' AS str</query>
        </scripts>

        <scripts>
            <query>GRANT SELECT ON default.can_read_specific TO 'can_read'</query>
        </scripts>
        <scripts>
            <query>GRANT SELECT ON default.can_read_general TO 'general_role'</query>
        </scripts>
    </startup_scripts>
</clickhouse>
