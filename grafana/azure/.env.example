# Microsoft Entra app registration that Grafana signs users in against, and
# whose tenant issues the access tokens ClickHouse accepts. Copy this file to
# .env and fill in your own values:
#
#   cp .env.example .env
#
# Both containers read this file: docker compose interpolates CLIENT_ID /
# CLIENT_SECRET / TENANT_ID into Grafana's GF_AUTH_AZUREAD_* settings, and
# ClickHouse reads TENANT_ID directly through the from_env attribute in
# clickhouse-config/processor_directory.xml.

# Application (client) ID of the app registration, from App registrations ->
# Overview in the Entra dashboard. Grafana also builds its requested scope
# from it (api://$CLIENT_ID/user_impersonation), so the app must expose that
# scope -- see Entra_setup.md.
CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID, from the same Overview page. ClickHouse derives the
# JWKS URL from it, so only tokens from this tenant validate.
TENANT_ID=00000000-0000-0000-0000-000000000000

# Client secret for the app registration, from Certificates & secrets.
# Grafana needs it to redeem the authorization code.
CLIENT_SECRET=

# Optional: override the Grafana image (defaults to grafana/grafana:12.0.2).
# GRAFANA_IMAGE=grafana/grafana:12.0.2
