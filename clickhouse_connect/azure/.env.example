# Azure Entra tenant + app registration. The app needs "Allow public client
# flows" = Yes (device code, app.py), Expose an API, and v2.0 tokens
# (requestedAccessTokenVersion: 2). See ../../grafana/azure/Entra_setup.md.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Required by confidential_client.py (client-credentials), and by interactive.py
# only if its redirect URI sits under the "Web" platform, which makes Azure
# demand client auth on the code exchange (AADSTS7000218).
#AZURE_CLIENT_SECRET=

# Pre-defined ClickHouse user — must equal the token's `upn` (whoever signs in).
CH_JWT_USER=you@example.com
