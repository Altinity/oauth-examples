# Azure Entra tenant + app registration. The app must be a PUBLIC client
# ("Allow public client flows" = Yes), Expose an API, and issue v2.0 tokens
# (requestedAccessTokenVersion: 2). See ../../grafana/azure/Entra_setup.md.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Pre-defined ClickHouse user — must equal the token's `upn` (whoever signs in).
CH_JWT_USER=you@example.com
