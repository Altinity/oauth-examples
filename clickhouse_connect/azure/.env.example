# Azure Entra tenant + app registration. One registration serves every script
# here: Expose an API (Application ID URI + a scope), v2.0 tokens
# (requestedAccessTokenVersion: 2), and "Allow public client flows" = Yes for
# the secretless flows. See ../../grafana/azure/Entra_setup.md.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Certificates & secrets -> new client secret. Required by
# confidential_client.py and web_app.py. interactive.py deliberately ignores
# this one, so setting it here cannot break that script's public-client flow.
#AZURE_CLIENT_SECRET=

# interactive.py's redirect URI. The platform it is registered under picks the
# mode: "Mobile and desktop applications" -> public client, send no secret;
# "Web" -> confidential, and Azure demands client auth on the code exchange
# (AADSTS7000218), so set AZURE_INTERACTIVE_CLIENT_SECRET too.
#AZURE_REDIRECT_URI=http://localhost:8400/
#AZURE_INTERACTIVE_CLIENT_SECRET=
# Where interactive.py caches its refresh token (mode 0600) so later runs skip
# the browser. Delete the file to force a fresh sign-in, or set this to "none"
# to keep the token in memory only, like the other scripts here.
#AZURE_TOKEN_CACHE=~/.cache/clickhouse-connect-azure/interactive.json

# web_app.py's redirect URI; register under Authentication -> "Web".
#AZURE_WEB_REDIRECT_URI=http://localhost:8500/auth/callback
#WEB_APP_PORT=8500
# Signs web_app.py's session cookie. Unset means a fresh key per process, so a
# restart signs everyone out.
#FLASK_SECRET_KEY=

# Pre-defined ClickHouse user for the delegated flows — must equal the token's
# `upn` (whoever signs in). confidential_client.py needs no counterpart: its
# app user is auto-provisioned from the service principal's `oid`.
CH_JWT_USER=you@example.com
