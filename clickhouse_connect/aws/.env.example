# Entra tenant and the public test client that signs the user in. The client
# needs the redirect URI http://localhost under Authentication ->
# "Mobile and desktop applications" (MSAL picks the port).
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Delegated scope exposed by the API registration (clickhouse-glue-test-api).
AZURE_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# Exact `aud` claim of that token — for a v2.0 token, the API's client id. The
# same value is in the AWS OIDC provider's client-id list and the trust policy.
AZURE_API_AUDIENCE=00000000-0000-0000-0000-000000000000

# Role ClickHouse assumes with the user's token (AssumeRoleWithWebIdentity).
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/clickhouse-glue-test-reader
#GLUE_REGION=eu-central-1
#GLUE_DATABASE=az-tokens
