# Keycloak users for app.py (ROPC). Must match keycloak-config/realm.json
# and clickhouse-config/startup_scripts.xml. Local demo only.
KEYCLOAK_USERNAME=alice@example.com
KEYCLOAK_PASSWORD=demo
KEYCLOAK_USERNAME_2=bob@example.com
KEYCLOAK_PASSWORD_2=demo

# Host ports, read by both docker compose and app.py.
KEYCLOAK_PORT=8080
CLICKHOUSE_PORT=8123
