# Azure Entra tenant that issues JWTs ClickHouse will accept.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Azure app registration used by azure-device-flow.sh.
# Two ways to make device-code redemption work:
#   (a) Public client — set "Allow public client flows" = Yes in the app's
#       Authentication blade. Leave AZURE_CLIENT_SECRET unset.
#   (b) Confidential client — leave the public-client toggle OFF, create a
#       client secret in Certificates & secrets, and set AZURE_CLIENT_SECRET.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Required only for option (b) above. Leave empty/unset for a public client.
AZURE_CLIENT_SECRET=
