<clickhouse>
    <!--
      User creation lives here, not in users.xml, because XML element names
      cannot contain '@' or '.' — and Azure usernames are usually e-mail / UPN
      style. The CREATE USER statement is taken verbatim from the env var
      CH_CREATE_USER_QUERY (built in docker-compose.yml from $CH_USERNAME).
    -->
    <startup_scripts>
        <scripts>
            <query>CREATE ROLE OR REPLACE azure_jwt_role</query>
        </scripts>
        <scripts>
            <query>GRANT SELECT ON default.* TO azure_jwt_role</query>
        </scripts>
        <scripts>
            <query>CREATE TABLE IF NOT EXISTS default.test_table_1 ENGINE=TinyLog AS SELECT toUInt64(123) AS id</query>
        </scripts>
        <scripts>
            <query from_env="CH_CREATE_USER_QUERY"></query>
        </scripts>
    </startup_scripts>
</clickhouse>
