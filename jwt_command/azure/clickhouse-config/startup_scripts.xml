<clickhouse>
    <!--
      We don't pre-create CH users here — jwt_processors.xml has a
      <user_directories><token>...</token></user_directories> block that
      auto-provisions a user for whoever signs in (named after the JWT
      'email' claim) and assigns them azure_jwt_role. We just need the
      role itself to exist.
    -->
    <startup_scripts>
        <scripts>
            <query>CREATE ROLE OR REPLACE azure_jwt_role</query>
        </scripts>
        <scripts>
            <query>GRANT SELECT ON default.* TO azure_jwt_role</query>
        </scripts>
        <scripts>
            <query>CREATE TABLE IF NOT EXISTS default.test_table_1 ENGINE=TinyLog AS SELECT toUInt64(123) AS id</query>
        </scripts>
    </startup_scripts>
</clickhouse>
