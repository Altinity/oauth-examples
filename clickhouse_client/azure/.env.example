# Azure Entra tenant + app registration. Needs "Expose an API" (Application ID
# URI + a scope) and v2.0 tokens (requestedAccessTokenVersion: 2).
# See ../../grafana/azure/Entra_setup.md.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Required by azure-client-credentials.sh.
#AZURE_CLIENT_SECRET=

# azure-interactive.sh ignores AZURE_CLIENT_SECRET unless this is 1, so the
# public-client flow stays the default even though the secret is present for the
# script above. Set it to 1 only when AZURE_REDIRECT_URI is registered under the
# "Web" platform; sending a secret for a "Mobile and desktop applications" URI
# fails with 401 AADSTS700025.
#AZURE_INTERACTIVE_USE_SECRET=0

# azure-interactive.sh's redirect URI. The port must match the one published in
# docker-compose.yml, since the browser runs on the host and the listener in
# the container.
#AZURE_REDIRECT_URI=http://localhost:8400/

# Pre-defined ClickHouse users, created on first init only — after changing
# either, re-provision with `docker compose down -v && docker compose up -d`.

# azure-interactive.sh — must equal the token's `upn` (whoever signs in).
CH_JWT_USER=you@example.com

# azure-client-credentials.sh — the service principal's object id, i.e. the
# app-only token's `oid`. Not the client id. Look it up with:
#   az ad sp show --id "$AZURE_CLIENT_ID" --query id -o tsv
CH_JWT_APP_USER=00000000-0000-0000-0000-000000000000
