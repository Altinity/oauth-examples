# Username for the pre-defined ClickHouse user. MUST match the user defined in
# keycloak-config/realm.json (which is hard-coded to alice@example.com — if you
# change CH_USERNAME here, also edit the user block in realm.json so the email
# claim matches what ClickHouse expects).
CH_USERNAME=alice@example.com

# Password the local OpenLDAP server provisions for $CH_USERNAME (used when
# authenticating via LDAP bind).
LDAP_USER_PASSWORD=ldappassword

# Password for the LDAP admin account (cn=admin,dc=example,dc=org).
LDAP_ADMIN_PASSWORD=adminpassword

# Password Keycloak provisions for $CH_USERNAME, also hard-coded in
# keycloak-config/realm.json. The keycloak-jwt.sh script POSTs this to
# Keycloak's /token endpoint (Resource Owner Password Credentials grant) to
# fetch a JWT with zero browser interaction. If you change it here, also edit
# realm.json. Not safe outside a local demo.
KEYCLOAK_PASSWORD=demo
